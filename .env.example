# All variables are OPTIONAL. Basic remote control works with none of them set.
# EXPO_PUBLIC_* values are embedded in the app bundle — never put a secret you
# cannot afford to leak here. Prefer entering keys in-app (stored in SecureStore).

# YouTube Data API v3 key used for search (Phase 4). Restrict it to the Android
# app's package + SHA-1 in Google Cloud Console.
EXPO_PUBLIC_YOUTUBE_API_KEY=

# Optional LLM endpoint for complex intent interpretation (Phase 3+). Should point
# at your own backend (apps/backend), not directly at a provider.
EXPO_PUBLIC_INTENT_API_URL=
